<form class="urop-sheet item-sheet" autocomplete="off">
  <header class="sheet-header"><img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="80" width="80"/><div class="header-main"><input name="name" type="text" value="{{item.name}}" placeholder="Modulname"/><div class="type-chip">Fahrzeugmodul</div></div></header>
  <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="effects">Beschreibung</a><a class="item" data-tab="details">Details</a><a class="item" data-tab="notes">Intern</a></nav>
  <section class="sheet-body"><div class="tab" data-group="primary" data-tab="details"><div class="grid two-col"><div class="card"><label>Kategorie</label><select name="system.moduleCategory"><option value="mobility" {{#if (uropEq item.system.moduleCategory "mobility")}}selected{{/if}}>Antrieb</option><option value="power" {{#if (uropEq item.system.moduleCategory "power")}}selected{{/if}}>Energie / Tank</option><option value="crew" {{#if (uropEq item.system.moduleCategory "crew")}}selected{{/if}}>Crew / Unterkunft</option><option value="cargo" {{#if (uropEq item.system.moduleCategory "cargo")}}selected{{/if}}>Laderaum</option><option value="sensors" {{#if (uropEq item.system.moduleCategory "sensors")}}selected{{/if}}>Sensorik</option><option value="control" {{#if (uropEq item.system.moduleCategory "control")}}selected{{/if}}>Steuerung</option><option value="network" {{#if (uropEq item.system.moduleCategory "network")}}selected{{/if}}>Netz / Kommunikation</option><option value="defense" {{#if (uropEq item.system.moduleCategory "defense")}}selected{{/if}}>Verteidigung</option><option value="utility" {{#if (uropEq item.system.moduleCategory "utility")}}selected{{/if}}>Utility</option><option value="special" {{#if (uropEq item.system.moduleCategory "special")}}selected{{/if}}>Spezial</option></select><label>Sektion</label><select name="system.sectionId"><option value="">Ohne Sektion</option>{{#each sectionOptions as |section|}}<option value="{{section.id}}" {{#if (uropEq ../item.system.sectionId section.id)}}selected{{/if}}>{{section.name}}</option>{{/each}}</select><label>Tier</label><input type="number" min="0" max="6" step="1" name="system.tier" value="{{item.system.tier}}"/></div><div class="card"><label>Größe</label><input type="text" name="system.sizeClass" value="{{item.system.sizeClass}}"/><label>Preis</label><input type="number" min="0" name="system.price" value="{{item.system.price}}"/><label>Verfügbarkeit</label><select name="system.availability"><option value="common" {{#if (uropEq item.system.availability "common")}}selected{{/if}}>Häufig</option><option value="uncommon" {{#if (uropEq item.system.availability "uncommon")}}selected{{/if}}>Ungewöhnlich</option><option value="restricted" {{#if (uropEq item.system.availability "restricted")}}selected{{/if}}>Eingeschränkt</option><option value="rare" {{#if (uropEq item.system.availability "rare")}}selected{{/if}}>Selten</option></select></div></div></div><div class="tab" data-group="primary" data-tab="effects"><div class="card"><label>Voraussetzungen</label><textarea name="system.prerequisitesText">{{item.system.prerequisitesText}}</textarea><label>Kurztext</label><textarea name="system.rulesShort">{{item.system.rulesShort}}</textarea><label>Beschreibung</label><textarea class="large" name="system.description">{{item.system.description}}</textarea></div></div><div class="tab" data-group="primary" data-tab="notes"><div class="card"><label>Interne Notiz</label><textarea class="large" name="system.notes">{{item.system.notes}}</textarea></div></div></section>
</form>
