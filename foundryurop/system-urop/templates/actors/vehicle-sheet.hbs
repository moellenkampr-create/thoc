<form class="urop-sheet" autocomplete="off">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="96" width="96"/>
    <div class="header-main"><input name="name" type="text" value="{{actor.name}}" placeholder="Fahrzeugname"/></div>
  </header>
  <div class="sheet-layout">
    <section class="sheet-body">
      <div class="tab" data-group="primary" data-tab="overview">
        <div class="grid two-col">
          <div class="card"><h3>Plattform</h3>
            <label>Klasse</label><select name="system.identity.vehicleClass"><option value="ground" {{#if (uropEq actor.system.identity.vehicleClass "ground")}}selected{{/if}}>Boden</option><option value="air" {{#if (uropEq actor.system.identity.vehicleClass "air")}}selected{{/if}}>Luft</option><option value="water" {{#if (uropEq actor.system.identity.vehicleClass "water")}}selected{{/if}}>Wasser</option><option value="space" {{#if (uropEq actor.system.identity.vehicleClass "space")}}selected{{/if}}>Raum</option><option value="drone" {{#if (uropEq actor.system.identity.vehicleClass "drone")}}selected{{/if}}>Drohne</option></select>
            <label>Untertyp</label><input type="text" name="system.identity.subtype" value="{{actor.system.identity.subtype}}"/>
            <div class="grid three-col"><div><label>Größe</label><input type="text" name="system.identity.sizeClass" value="{{actor.system.identity.sizeClass}}"/></div><div><label>Tier</label><input type="number" min="0" max="6" step="1" name="system.identity.tier" value="{{actor.system.identity.tier}}"/></div><div><label>Preis</label><input type="number" min="0" name="system.identity.price" value="{{actor.system.identity.price}}"/></div></div>
            <label>Verfügbarkeit</label><select name="system.identity.availability"><option value="common" {{#if (uropEq actor.system.identity.availability "common")}}selected{{/if}}>Häufig</option><option value="uncommon" {{#if (uropEq actor.system.identity.availability "uncommon")}}selected{{/if}}>Ungewöhnlich</option><option value="restricted" {{#if (uropEq actor.system.identity.availability "restricted")}}selected{{/if}}>Eingeschränkt</option><option value="rare" {{#if (uropEq actor.system.identity.availability "rare")}}selected{{/if}}>Selten</option></select>
          </div>
          <div class="card"><h3>Fahrt und Besatzung</h3>
            <label>Geschwindigkeit</label><input type="number" min="0" max="6" step="1" name="system.performance.speed" value="{{actor.system.performance.speed}}"/><input type="text" name="system.performance.speedDisplay" value="{{actor.system.performance.speedDisplay}}" placeholder="z. B. 220 km/h"/>
            <label>Beschleunigung</label><input type="number" min="0" max="6" step="1" name="system.performance.acceleration" value="{{actor.system.performance.acceleration}}"/><input type="text" name="system.performance.accelerationDisplay" value="{{actor.system.performance.accelerationDisplay}}" placeholder="z. B. 0-100 km/h in 4 s"/>
            <label>Manövrierbarkeit</label><input type="number" min="0" max="6" step="1" name="system.performance.maneuverability" value="{{actor.system.performance.maneuverability}}"/>
            <label>Crew</label><input type="text" name="system.operation.crew" value="{{actor.system.operation.crew}}" placeholder="z. B. 1 Fahrer, 2 Passagiere"/>
            <label>Passagierplätze</label><input type="number" min="0" name="system.operation.passengerCapacity" value="{{actor.system.operation.passengerCapacity}}"/>
            <label>Fahrverhalten</label><textarea name="system.operation.handlingNotes">{{actor.system.operation.handlingNotes}}</textarea>
          </div>
        </div>
        <div class="card"><h3>Kurzbeschreibung</h3><textarea class="large" name="system.notes.summary">{{actor.system.notes.summary}}</textarea></div>
      </div>
      <div class="tab" data-group="primary" data-tab="modules"><div class="card"><div class="list-header"><h3>Module</h3><button type="button" class="create-item-btn" data-action="create-item" data-item-type="vehicle_module">+</button></div>{{#each sectionGroups as |section|}}<h3>{{section.name}}</h3><table class="combat-skill-table"><thead><tr><th>Modul</th><th>Art</th><th>Tier</th><th>Größe</th><th>Preis</th></tr></thead><tbody>{{#each section.modules as |item|}}<tr><td><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></td><td>{{item.system.moduleCategory}}</td><td>{{item.system.tier}}</td><td>{{item.system.sizeClass}}</td><td>{{item.system.price}}</td></tr>{{/each}}</tbody></table>{{/each}}{{#if unassignedItems.modules.length}}<h3>Ohne Sektion</h3>{{#each unassignedItems.modules as |item|}}<div><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></div>{{/each}}{{/if}}</div></div>
      <div class="tab" data-group="primary" data-tab="combat"><div class="grid two-col"><div class="card"><div class="list-header"><h3>Waffen</h3><button type="button" class="create-item-btn" data-action="create-item" data-item-type="weapon">+</button></div>{{#each sectionGroups as |section|}}<h3>{{section.name}}</h3><ul class="item-list interactive-list">{{#each section.weapons as |item|}}<li><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></li>{{/each}}</ul>{{/each}}{{#if unassignedItems.weapons.length}}<h3>Ohne Sektion</h3>{{#each unassignedItems.weapons as |item|}}<li><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></li>{{/each}}{{/if}}</div><div class="card"><div class="list-header"><h3>Panzerung</h3><button type="button" class="create-item-btn" data-action="create-item" data-item-type="armor">+</button></div>{{#each sectionGroups as |section|}}<h3>{{section.name}}</h3><ul class="item-list interactive-list">{{#each section.armor as |item|}}<li><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></li>{{/each}}</ul>{{/each}}{{#if unassignedItems.armor.length}}<h3>Ohne Sektion</h3>{{#each unassignedItems.armor as |item|}}<li><button type="button" class="item-open" data-action="open-item" data-item-id="{{item._id}}">{{item.name}}</button></li>{{/each}}{{/if}}</div></div><div class="grid three-col"><div class="card"><h3>Leichte Konsequenzen</h3>{{#each consequenceFields.light as |slot|}}<input type="text" name="system.consequences.light.{{slot.index}}" value="{{slot.value}}"/>{{/each}}</div><div class="card"><h3>Schwere Konsequenzen</h3>{{#each consequenceFields.heavy as |slot|}}<input type="text" name="system.consequences.heavy.{{slot.index}}" value="{{slot.value}}"/>{{/each}}</div><div class="card"><h3>Kritische Konsequenzen</h3>{{#each consequenceFields.critical as |slot|}}<input type="text" name="system.consequences.critical.{{slot.index}}" value="{{slot.value}}"/>{{/each}}</div></div></div>
      <div class="tab" data-group="primary" data-tab="settings"><div class="grid two-col"><div class="card"><div class="list-header"><h3>Sektionen</h3><button type="button" class="create-item-btn" data-action="add-section">+</button></div>{{#each sections as |section index|}}<div class="section-row"><input type="text" name="system.settings.sections.{{index}}.id" value="{{section.id}}"/><input type="text" name="system.settings.sections.{{index}}.name" value="{{section.name}}"/><textarea name="system.settings.sections.{{index}}.notes">{{section.notes}}</textarea><button type="button" data-action="remove-section" data-index="{{index}}" {{#if @first}}disabled{{/if}}>X</button></div>{{/each}}</div><div class="card"><h3>Konsequenzfelder</h3><label>Leicht</label><input type="number" min="0" max="12" name="system.settings.consequenceSlots.light" value="{{actor.system.settings.consequenceSlots.light}}"/><label>Schwer</label><input type="number" min="0" max="12" name="system.settings.consequenceSlots.heavy" value="{{actor.system.settings.consequenceSlots.heavy}}"/><label>Kritisch</label><input type="number" min="0" max="12" name="system.settings.consequenceSlots.critical" value="{{actor.system.settings.consequenceSlots.critical}}"/><label>Szenennotiz</label><textarea name="system.scene.notes">{{actor.system.scene.notes}}</textarea><label>SL-Notiz</label><textarea name="system.notes.gm">{{actor.system.notes.gm}}</textarea></div></div></div>
    </section>
    <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="overview">Übersicht</a><a class="item" data-tab="modules">Module</a><a class="item" data-tab="combat">Kampf</a><a class="item" data-tab="settings">Einstellungen</a></nav>
  </div>
</form>
